{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grill-to-spec/prd.schema.json",
  "title": "Grill to Spec PRD",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "problem_statement",
    "goals",
    "user_stories",
    "requirements",
    "acceptance_criteria",
    "traceability",
    "quality_gates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "slug",
        "generated_at"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "priority",
          "source_refs",
          "acceptance_criteria"
        ]
      }
    }
  }
}
